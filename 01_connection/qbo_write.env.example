# Write-scoped credentials for 01_connection/load_workbook_to_sandbox.py (sandbox only). Copy to a path OUTSIDE the project,
# fill in your own Intuit developer sandbox values, and pass it with --env-file. Never commit the filled-in copy.
QBO_WRITE_CLIENT_ID=your_sandbox_client_id
QBO_WRITE_CLIENT_SECRET=your_sandbox_client_secret
QBO_WRITE_REFRESH_TOKEN=your_sandbox_refresh_token
QBO_WRITE_REALM_ID=your_sandbox_realm_id
QBO_WRITE_ENVIRONMENT=sandbox
